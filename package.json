{
  "name": "repetitor-game",
  "private": true,
  "description": "Словарная битва: игра-тренажёр по русскому языку для младших школьников",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,green \"VITE_BACKEND=1 npm run dev -w @repetitor/web\" \"npm run dev -w @repetitor/api\"",
    "build": "npm run build -w @repetitor/web",
    "check": "npm run build && npm run build:online && node --disable-warning=ExperimentalWarning scripts/check.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "simple-git-hooks",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:offline": "npm run dev -w @repetitor/web",
    "build:online": "VITE_BACKEND=1 OUT_DIR=dist-online npm run build -w @repetitor/web",
    "secrets": "node scripts/no-secrets.mjs",
    "cloud:password": "node --disable-warning=ExperimentalWarning scripts/cloud/set-password.mjs",
    "cloud:deploy": "node --disable-warning=ExperimentalWarning scripts/cloud/deploy.mjs",
    "cloud:test-ydb": "scripts/cloud/test-ydb.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "node scripts/no-secrets.mjs",
    "*.{js,mjs,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,html,json,md,yml}": "prettier --write"
  }
}
